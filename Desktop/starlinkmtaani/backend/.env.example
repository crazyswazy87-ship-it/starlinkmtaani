# Safaricom Daraja (M-PESA) app credentials — from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY="3lv15BiGfmEheu2hBtA09gqAProUFOTkoTAYMxXJiwDLAOP7"
MPESA_CONSUMER_SECRET="G6QG18hhrbvpgR9MIgXfq5sIkB6oAJ8UJKJsJlKsFkH4DRRtptxogv1xfoQI69Sz"
MPESA_SHORTCODE= "174379"
MPESA_PASSKEY= "bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_ENV=sandbox

# Public HTTPS URL Safaricom will POST the payment result to.
# In sandbox, use ngrok or similar: https://<your-tunnel>.ngrok.io/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.example.com/api/mpesa/callback

PORT=4000

# Router / RADIUS integration (optional) — used to actually lift the
# walled-garden restriction once a transaction is confirmed. Leave
# blank to run the portal in "log only" mode.
ROUTER_API_URL=
ROUTER_API_KEY=

# --- Free trial / Connect TV / reporting (all optional) ---------------------
# Length of the first-connection free trial, in seconds (default 1800 = 30 min).
TRIAL_SECONDS=1800
# How many TVs one active package can cover (default 2).
TV_LIMIT=2
# How often expired trials / packages / TVs are cut off at the router (ms).
SWEEP_INTERVAL_MS=15000
# Hours ahead of UTC used to bucket the spending dashboard by month (3 = East Africa Time).
REPORT_TZ_OFFSET_HOURS=3
# Set to "production" when live: it disables the shared 'demo-device' identity,
# so the free trial is only ever given to a real, router-supplied MAC address.
NODE_ENV=development

# Ending access: a second router endpoint called when a trial/package/TV is over
# (e.g. a MikroTik hotspot-user removal or RADIUS Disconnect-Request wrapper).
# REQUIRED once ROUTER_API_URL is set, otherwise expiry can't be enforced here.
ROUTER_REVOKE_URL=
